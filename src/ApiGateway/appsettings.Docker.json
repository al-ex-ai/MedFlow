{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "Server=sqlserver;Database=master;User Id=sa;Password=StrongPassword123!;TrustServerCertificate=true",
    "MongoDB": "mongodb://admin:admin123@mongodb:27017",
    "Redis": "redis:6379",
    "RabbitMQ": "amqp://admin:admin123@rabbitmq:5672"
  },
  "ServiceUrls": {
    "PatientService": "http://patient-service",
    "AppointmentService": "http://appointment-service",
    "BillingService": "http://billing-service",
    "NotificationService": "http://notification-service"
  },
  "HealthCheckUI": {
    "Url": "http://localhost/health"
  },
  "ReverseProxy": {
    "Routes": {
      "patient-route": {
        "ClusterId": "patient-cluster",
        "Match": {
          "Path": "/api/patients/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/patients/{**catch-all}"
          }
        ]
      },
      "appointment-route": {
        "ClusterId": "appointment-cluster",
        "Match": {
          "Path": "/api/appointments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/appointments/{**catch-all}"
          }
        ]
      },
      "billing-route": {
        "ClusterId": "billing-cluster",
        "Match": {
          "Path": "/api/invoices/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/invoices/{**catch-all}"
          }
        ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/notifications/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "patient-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "patient-service-1": {
            "Address": "http://patient-service"
          }
        }
      },
      "appointment-cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "appointment-service-1": {
            "Address": "http://appointment-service"
          }
        }
      },
      "billing-cluster": {
        "LoadBalancingPolicy": "LeastRequests",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "billing-service-1": {
            "Address": "http://billing-service"
          }
        }
      },
      "notification-cluster": {
        "LoadBalancingPolicy": "Random",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "notification-service-1": {
            "Address": "http://notification-service"
          }
        }
      }
    }
  }
}
